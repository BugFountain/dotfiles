# Diego Stack B: Ghostty + zsh + Starship + antidote (no OMZ / no p10k)
# Portable via ~/dotfiles — see README.md

export DOTFILES="${DOTFILES:-$HOME/dotfiles}"

# ── Lean shell for AI agents ──────────────────────────────────────────────────
# Skip heavy prompt/plugins for non-interactive shells and agent subprocesses.
_zsh_is_lean_shell() {
  [[ ! -o interactive ]] && return 0
  # Bare zsh has no EXTENDED_GLOB (OMZ used to enable @(...) patterns).
  if [[ -n "${CURSOR_AGENT:-}" ]]; then
    case "${TERM_PROGRAM:-}" in
      Cursor|vscode) return 0 ;;
    esac
  fi
  [[ -n "${COMPOSER_NO_INTERACTION:-}" ]] && return 0
  [[ -n "${CLAUDE_CODE_CHILD_SESSION:-}" ]] && return 0
  return 1
}

# Completions path (dotfiles + Homebrew + zsh-completions via antidote)
fpath=("$DOTFILES/zsh/completions" /opt/homebrew/share/zsh/site-functions $fpath)
autoload -Uz compinit
compinit -C

# Shared PATH + lazy runtimes (nvm/rbenv); mise activates below when present
[[ -f "$DOTFILES/zsh/lean-path.zsh" ]] && source "$DOTFILES/zsh/lean-path.zsh"
[[ -f "$DOTFILES/zsh/runtimes.zsh" ]] && source "$DOTFILES/zsh/runtimes.zsh"
[[ -f "$DOTFILES/zsh/cyberpunk.zsh" ]] && source "$DOTFILES/zsh/cyberpunk.zsh"
[[ -f "$DOTFILES/zsh/aliases.zsh" ]] && source "$DOTFILES/zsh/aliases.zsh"

# mise (optional — sits beside nvm/rbenv until you migrate)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if ! _zsh_is_lean_shell; then
  # Plugins via antidote
  if [[ -r /opt/homebrew/opt/antidote/share/antidote/antidote.zsh ]]; then
    source /opt/homebrew/opt/antidote/share/antidote/antidote.zsh
  elif [[ -r /usr/local/opt/antidote/share/antidote/antidote.zsh ]]; then
    source /usr/local/opt/antidote/share/antidote/antidote.zsh
  fi
  if (( $+functions[antidote] )); then
    antidote load "$DOTFILES/zsh/zsh_plugins.txt"
  fi

  # Autosuggest style (cyberpunk mute)
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=${CTP_MUTED:-#9a96a8}"

  # Syntax highlight — never paint unknown cmds as candy/ANSI red (feels like an error mid-type).
  # Mute for unknown; purple for builtins/aliases; ink for real commands; mint for paths.
  typeset -A ZSH_HIGHLIGHT_STYLES
  ZSH_HIGHLIGHT_STYLES[default]='fg=#f1efe8'
  ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#9a96a8'
  ZSH_HIGHLIGHT_STYLES[reserved-word]='fg=#8b7cff'
  ZSH_HIGHLIGHT_STYLES[alias]='fg=#8b7cff'
  ZSH_HIGHLIGHT_STYLES[builtin]='fg=#8b7cff'
  ZSH_HIGHLIGHT_STYLES[function]='fg=#8b7cff'
  ZSH_HIGHLIGHT_STYLES[command]='fg=#f1efe8'
  ZSH_HIGHLIGHT_STYLES[precommand]='fg=#8b7cff'
  ZSH_HIGHLIGHT_STYLES[path]='fg=#7dffa8'
  ZSH_HIGHLIGHT_STYLES[globbing]='fg=#ff5a9a'
  ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#ff5a9a'
  ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#ff5a9a'
  ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg=#9a96a8'
  ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg=#9a96a8'
  ZSH_HIGHLIGHT_STYLES[comment]='fg=#9a96a8'

  # History
  HISTFILE="${HOME}/.zsh_history"
  HISTSIZE=50000
  SAVEHIST=50000
  setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

  # Starship prompt
  if command -v starship >/dev/null 2>&1; then
    export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$DOTFILES/starship.toml}"
    eval "$(starship init zsh)"
  fi

  # atuin (history DB) — after starship so widgets bind cleanly
  if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh --disable-up-arrow)"
  fi

  # fzf + zoxide
  if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
  fi
  if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
  fi

  # Modern CLI aliases (keep classic names as fallbacks)
  if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l --group-directories-first --icons=auto'
    alias la='eza -la --group-directories-first --icons=auto'
    alias tree='eza --tree --icons=auto'
  fi
  if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'
    export BAT_THEME="${BAT_THEME:-Catppuccin Mocha}"
  fi
  command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'

  # delta as git pager when available
  if command -v delta >/dev/null 2>&1; then
    export GIT_PAGER=delta
  fi
else
  # Lean prompt for agents — no Starship/plugins
  PROMPT='%F{red}%n@%m%f:%F{blue}%~%f$ '
  RPROMPT=''
fi

# bun completions (interactive only)
if ! _zsh_is_lean_shell && [[ -s "$HOME/.bun/_bun" ]]; then
  source "$HOME/.bun/_bun"
fi

