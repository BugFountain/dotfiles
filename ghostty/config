# Diego Ghostty — portable via ~/dotfiles
# Docs: https://ghostty.org/docs/config

# Locked cyberpunk palette (no Catppuccin / no cyan-lime-yellow)
background = #07060b
foreground = #f1efe8
cursor-color = #ff2d6a
cursor-text = #07060b
selection-background = #1c1828
selection-foreground = #f1efe8

# ANSI 0-7
palette = 0=#14121c
palette = 1=#ff2d6a
palette = 2=#7dffa8
palette = 3=#ff5a9a
palette = 4=#8b7cff
palette = 5=#ff5a9a
palette = 6=#9a96a8
palette = 7=#f1efe8
# ANSI 8-15 (bright)
palette = 8=#1c1828
palette = 9=#ff2d6a
palette = 10=#7dffa8
palette = 11=#ff5a9a
palette = 12=#8b7cff
palette = 13=#ff5a9a
palette = 14=#9a96a8
palette = 15=#f1efe8

# Same face as artifact code stacks (Nerd Font patch for glyphs)
font-family = Monocraft
font-size = 15
font-thicken = true
font-feature = -liga
font-feature = -calt

# Comfortable grid + packing (artifact density vibe)
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
adjust-cell-height = 15%

# macOS chrome
macos-titlebar-style = tabs
macos-option-as-alt = true
window-save-state = always
window-inherit-working-directory = true
window-inherit-font-size = true

# Shell / clipboard
shell-integration = zsh
shell-integration-features = cursor,sudo,title
copy-on-select = clipboard
clipboard-paste-protection = true
mouse-hide-while-typing = true

# Readability
minimum-contrast = 1.1
cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000000

# Splits
unfocused-split-opacity = 0.85
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next

auto-update-channel = stable
